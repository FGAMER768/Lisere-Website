# Domaine public du site, sans slash final.
# En local : copiez ce fichier vers .env.
# Sur Cloudflare Pages : Settings > Environment variables, pour Production et Preview.
# Cette valeur est lue au build par astro.config.mjs pour les URL canoniques,
# la sitemap, robots.txt et les images Open Graph.
SITE_URL=https://lisere.pages.dev
