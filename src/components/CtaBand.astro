---
import './CtaBand.css';

interface Props {
  title: string;
  lead: string;
  tone?: 'dark' | 'light';
  class?: string;
}

const { title, lead, tone = 'dark', class: className } = Astro.props;
---

<section
  class:list={[
    'cta-band',
    tone === 'dark' ? 'section--night' : 'cta-band--light',
    className,
  ]}
>
  <div class="container cta-band__inner">
    <div class="cta-band__copy">
      <h2>{title}</h2>
      <p class="cta-band__lead">{lead}</p>
    </div>
    <div class="cta-band__actions">
      <slot />
    </div>
  </div>
</section>
