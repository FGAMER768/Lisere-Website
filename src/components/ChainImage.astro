---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
}

const { src, alt } = Astro.props;
---

<Picture
  src={src}
  alt={alt}
  formats={['avif', 'webp']}
  widths={[420, 640, 960]}
  sizes="(min-width: 1000px) 860px, 92vw"
  quality={82}
  loading="lazy"
  decoding="async"
  class="chains__image"
/>
