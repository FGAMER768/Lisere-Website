---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import './BeforeAfter.css';

interface Props {
  before: ImageMetadata;
  after: ImageMetadata;
  beforeAlt: string;
  afterAlt: string;
  caption?: string;
  credit?: string;
  creditHref?: string;
  initial?: number;
  eager?: boolean;
  sizes?: string;
  beforeLabel?: string;
  afterLabel?: string;
  class?: string;
}

const {
  before,
  after,
  beforeAlt,
  afterAlt,
  caption,
  credit,
  creditHref,
  initial = 52,
  eager = false,
  sizes = '(min-width: 960px) 58vw, 100vw',
  beforeLabel = 'Avant',
  afterLabel = 'Après',
  class: className,
} = Astro.props;

const value = Math.min(100, Math.max(0, initial));
---

<figure
  class:list={['compare', className]}
  data-compare
  style={`--compare-position:${value}%`}
>
  <div class="compare__frame">
    <div class="compare__base">
      <Picture
        src={before}
        alt={beforeAlt}
        formats={['avif', 'webp']}
        widths={[450, 675, 900]}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
        decoding="async"
        quality={86}
        class="compare__image"
      />
    </div>

    <div class="compare__top">
      <Picture
        src={after}
        alt={afterAlt}
        formats={['avif', 'webp']}
        widths={[450, 675, 900]}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
        decoding="async"
        quality={86}
        class="compare__image"
      />
    </div>

    {beforeLabel && <span class="compare__label compare__label--before">{beforeLabel}</span>}
    {afterLabel && <span class="compare__label compare__label--after">{afterLabel}</span>}

    <div class="compare__divider" aria-hidden="true">
      <span class="compare__handle"></span>
    </div>

    <input
      class="compare__range"
      type="range"
      min="0"
      max="100"
      step="1"
      value={value}
      aria-label={caption ? `Comparer : ${caption}` : 'Comparer l’image avant et après'}
      aria-valuetext={`${value} % de l’image après`}
      data-compare-range
    />
  </div>

  {(caption || credit) && (
    <figcaption class="compare__caption">
      <div>
        {caption && <p class="compare__description">{caption}</p>}
        {credit && (
          <p class="compare__credit">
            {creditHref ? (
              <a href={creditHref} rel="noopener noreferrer">{credit}</a>
            ) : (
              credit
            )}
          </p>
        )}
      </div>
      <p class="compare__hint">Faites glisser le séparateur</p>
    </figcaption>
  )}
</figure>
