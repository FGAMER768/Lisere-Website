---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import './FilmStrip.css';

interface Props {
  images: ImageMetadata[];
  alt: string;
}

const { images, alt } = Astro.props;
const timecodes = ['00:00', '00:04', '00:08', '00:12', '00:16', '00:20'];
---

<figure class="film-strip">
  <div class="film-strip__viewport">
    <div class="film-strip__track">
      {
        images.map((image, index) => (
          <div class="film-strip__frame">
            <div class="film-strip__image">
              <Image
                src={image}
                alt={index === 0 ? alt : ''}
                widths={[180, 240, 360, 480, 720]}
                sizes="(min-width: 900px) 7vw, 90px"
                format="webp"
                quality={80}
                loading="lazy"
                decoding="async"
              />
            </div>
            <span class="film-strip__time">{timecodes[index]}</span>
          </div>
        ))
      }
      <span class="film-strip__playhead" aria-hidden="true"></span>
    </div>
  </div>
</figure>
