---
import './SectionHeader.css';

interface Props {
  title: string;
  intro?: string;
  tone?: 'light' | 'dark';
  size?: 'default' | 'large';
  id?: string;
  class?: string;
}

const {
  title,
  intro,
  tone = 'light',
  size = 'default',
  id,
  class: className,
} = Astro.props;
---

<header
  class:list={[
    'section-header',
    `section-header--${tone}`,
    `section-header--${size}`,
    intro && 'section-header--with-intro',
    className,
  ]}
>
  <h2 id={id} class="section-header__title">{title}</h2>
  {intro && <p class="section-header__intro">{intro}</p>}
</header>
